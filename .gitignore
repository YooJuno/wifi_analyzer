/build/
/dist/
/release/
*.egg-info/
.eggs/
/WiFiAnalyzer.app/
/WiFiAnalyzer.previous.app/
/WiFiAnalyzer.launcher.app/

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# IDE-local files
.idea/
.vscode/
